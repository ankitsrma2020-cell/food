PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.<your-id>.mongodb.net/InstagramDB?retryWrites=true&w=majority
# Optional comma-separated DNS servers if Node cannot resolve Atlas SRV records.
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5173
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
